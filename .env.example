# GroundTruth configuration. Copy to ".env" for local runs (never commit
# .env), or set the same keys in the Render dashboard for the deployed
# service. No real secrets belong in this file.

# --- Required ------------------------------------------------------------

# Production (Neon Postgres + pgvector): paste the connection string Neon
# gives you. The bare postgresql:// scheme is fine — the app rewrites it
# to the psycopg v3 driver itself (see evidence/db.py).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=<redacted>

# --- Local development alternative ---------------------------------------
# SQLite file instead of Postgres (exercises the API surface locally;
# not the production store):
# DATABASE_URL=sqlite:///./groundtruth.db

# --- Optional --------------------------------------------------------------

# Minimum dense-similarity evidence score required before the app will
# answer instead of abstaining. Default: 0.35.
# GT_MIN_EVIDENCE_SCORE=0.35

# Gemini generation model override. Default: gemini-2.5-flash.
# GT_GENERATION_MODEL=gemini-2.5-flash
